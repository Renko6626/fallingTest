// 法术表（M4 Task 5，spec §3.4）。加载器：sand-harness::scenario::load_spells。
//
// 扁平记录，无引用无递归（用户裁决："只三原语"）。三个 kind：
//   Bolt  ( damage, knockback )                    直射弹，命中生物扣血+击退
//   Blast ( power, radius, max_durability )         爆炸弹，命中即炸（网格+刚体）
//   Spray ( material, count, speed, jitter )        喷射，不产生弹体，当帧走 emit
//
// 双闸门字段：mana（千分位量化）、cooldown（tick）。
// 出射：speed/gravity（Fx 量化）、spread_deg（BAM 量化，校验 0..=180）、grace（tick）。
// 侵彻公共字段（Task 6 消费）：dig_power、max_durability（顶层，弹体自身的侵彻
// 门槛，与 Blast::max_durability——爆炸自身的破坏门槛——是两个独立字段）。
// 运动修饰（Task 6 消费）：air_friction、liquid_drag（Fx 量化）、pass_through
// （Category 名列表 → 位掩码，未知名报错）、displace_liquid。
// 弹跳（Task 6 消费）：bounces、bounce_energy（Fx 量化）。
// 与刚体（Task 6 消费）：physics_impulse（千分位量化）。
// 死亡（Task 6 消费）：on_lifetime_out_explode。
//
// `slow_bolt`/`wet_bolt`（M4 Task 6 追加）：`crates/sand-core/tests/common/mod.rs`
// 的核心测试不读本文件（"core 测试不读 data/"，该文件头注）、这两条纯粹是
// production 侧的手感样例——`slow_bolt` 展示 air_friction < 1 的减速直射弹，
// `wet_bolt` 展示 liquid_drag（配 pass_through 含 liquid，否则会在入水第一格
// 就当场"命中"消失，见 `projectile.rs::blocks_projectile` 文档）。
//
// `scatter_bolt`（M4 Task 7 Step 3 追加）：同上一条先例——只服务
// `spread_angle_is_uniform_within_the_declared_cone` 散布角分布回归，产品
// 与 `duel.ron` 都不消费，见该条目内注释。
(
  spells: [
    (
      name: "spark_bolt",
      kind: Bolt( damage: 5.0, knockback: 2.0 ),
      mana: 10.0, cooldown: 12,
      speed: 8.0, life: 120, gravity: 0.0, spread_deg: 2.0, grace: 4,
      dig_power: 0, max_durability: 10,
      air_friction: 1.0, liquid_drag: 0.9, pass_through: ["gas"],
      displace_liquid: false,
      bounces: 0, bounce_energy: 0.5,
      physics_impulse: 0.0,
      on_lifetime_out_explode: false,
    ),
    (
      name: "bomb",
      kind: Blast( power: 1200, radius: 12, max_durability: 10 ),
      mana: 35.0, cooldown: 60,
      speed: 5.0, life: 180, gravity: 0.25, spread_deg: 0.0, grace: 20,
      dig_power: 0, max_durability: 10,
      air_friction: 1.0, liquid_drag: 0.8, pass_through: ["gas"],
      displace_liquid: true,
      bounces: 2, bounce_energy: 0.4,
      physics_impulse: 0.0,
      on_lifetime_out_explode: true,
    ),
    (
      name: "oil_spray",
      kind: Spray( material: "oil", count: 12, speed: 4.0, jitter: 0.6 ),
      mana: 8.0, cooldown: 6,
      speed: 0.0, life: 0, gravity: 0.0, spread_deg: 0.0, grace: 0,
      dig_power: 0, max_durability: 10,
      air_friction: 1.0, liquid_drag: 1.0, pass_through: [],
      displace_liquid: false,
      bounces: 0, bounce_energy: 0.0,
      physics_impulse: 0.0,
      on_lifetime_out_explode: false,
    ),
    (
      name: "digger",
      kind: Bolt( damage: 1.0, knockback: 0.0 ),
      mana: 15.0, cooldown: 20,
      speed: 6.0, life: 90, gravity: 0.0, spread_deg: 0.0, grace: 4,
      dig_power: 900, max_durability: 12,
      air_friction: 1.0, liquid_drag: 1.0, pass_through: ["gas", "liquid"],
      displace_liquid: false,
      bounces: 0, bounce_energy: 0.0,
      physics_impulse: 0.0,
      on_lifetime_out_explode: false,
    ),
    (
      name: "expensive_bolt",
      kind: Bolt( damage: 30.0, knockback: 6.0 ),
      mana: 90.0, cooldown: 90,
      speed: 10.0, life: 120, gravity: 0.0, spread_deg: 0.0, grace: 4,
      dig_power: 0, max_durability: 10,
      air_friction: 1.0, liquid_drag: 0.9, pass_through: ["gas"],
      displace_liquid: false,
      bounces: 0, bounce_energy: 0.0,
      // 0.3，不是 20.0——见 `body.rs::apply_projectile_impulse` 文档"coeff 的
      // 量级"一段：这么小的刚体上，20.0 这种量级会把 Δv 冲出合理范围，一两
      // tick 内推穿世界边界、被墙弹回来（TDD 阶段实测撞见）。
      physics_impulse: 0.3,
      on_lifetime_out_explode: false,
    ),
    (
      name: "slow_bolt",
      kind: Bolt( damage: 3.0, knockback: 1.0 ),
      mana: 6.0, cooldown: 8,
      speed: 8.0, life: 120, gravity: 0.0, spread_deg: 0.0, grace: 4,
      dig_power: 0, max_durability: 10,
      air_friction: 0.9, liquid_drag: 1.0, pass_through: ["gas"],
      displace_liquid: false,
      bounces: 0, bounce_energy: 0.0,
      physics_impulse: 0.0,
      on_lifetime_out_explode: false,
    ),
    (
      name: "wet_bolt",
      kind: Bolt( damage: 4.0, knockback: 1.5 ),
      mana: 8.0, cooldown: 10,
      speed: 8.0, life: 120, gravity: 0.0, spread_deg: 0.0, grace: 4,
      dig_power: 0, max_durability: 10,
      air_friction: 1.0, liquid_drag: 0.7, pass_through: ["gas", "liquid"],
      displace_liquid: false,
      bounces: 0, bounce_energy: 0.0,
      physics_impulse: 0.0,
      on_lifetime_out_explode: false,
    ),
    // `scatter_bolt`（M4 Task 7 Step 3 追加）：**只服务
    // `crates/sand-core/tests/projectile_behavior.rs::
    // spread_angle_is_uniform_within_the_declared_cone` 那条散布角分布
    // 回归**——core 测试实际读的是 `crates/sand-core/tests/common/mod.rs`
    // 里同名的独立法术定义（"core 测试不读 data/"，该文件头注），这里补一
    // 条只是让生产法术表与测试法术表对得上号，不代表本条真的被产品消费。
    // `spread_deg: 30.0` 是全表唯一非零散布值——`spread_bam` 字段本身就是
    // 半张角（`spell.rs::cast_all` 直接拿它当 `bam_in_range` 的 half 用），
    // 30° 声明出的是 ±30°（60° 全锥角），不是"半角 15°"。`cooldown: 1` +
    // `life: 1` 让它能每 tick 出一发、出生即可观测、下一 tick 自动销毁。
    // `duel.ron` 不用它（文件头注已交代）。
    (
      name: "scatter_bolt",
      kind: Bolt( damage: 0.0, knockback: 0.0 ),
      mana: 0.0, cooldown: 1,
      speed: 8.0, life: 1, gravity: 0.0, spread_deg: 30.0, grace: 0,
      dig_power: 0, max_durability: 10,
      air_friction: 1.0, liquid_drag: 1.0, pass_through: [],
      displace_liquid: false,
      bounces: 0, bounce_energy: 0.0,
      physics_impulse: 0.0,
      on_lifetime_out_explode: false,
    ),
  ],
)
