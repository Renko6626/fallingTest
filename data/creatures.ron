// 生物模板表（M4 spec §3.5）。加载器：sand-harness::scenario::load_creatures。
//
// hp_max / mana_max：千分位整数量化（quantize_milli，×1000 round）。
// mana_regen（点/秒）与 damage_from 的 dps：加载期一次性折成每 tick 千分位
// （quantize_milli_per_tick，×1000/60 round）——运行时 `step_world_interaction`
// 因此是纯整数乘加，不做除法。
//
// damage_from 的材质名经 table.id_by_name 解析，未知名报错；解析后按材质 id
// 升序排序（定序遍历红线，Noita mDamageMaterials 注释 "NOTE! Sorted!" 同款）。
//
// **damage_from 已裁剪至 "fire" 一项**（M4 Task 5 修正，取代 Task 3 提交时
// 的 "lava"/"acid" 两项）：那两种材质当时、此刻都不在 data/materials.ron 里
// ——Task 3 提交时 main.rs 尚未接线本文件，不会触发加载失败；本 Task 一旦把
// `load_creatures("data/creatures.ron", ..)` 接进 main.rs，"未知材质报错、
// 不静默丢弃"这条契约会立刻让加载失败。裁决：**裁剪引用，不给 materials.ron
// 添材质**——添两种新材质会改变 `materials_fp`，逼迫本无变更理由的全部六个
// golden 因材质表内容哈希改变而再录一次（本 Task 唯一的合法重录理由是
// `creatures_fp`/`spells_fp` 两行的加入，§CHANGELOG/commit 已言明"只此一次"）；
// 而"生物怕熔岩/强酸"在 M4 阶段没有任何可玩内容依赖它（没有熔岩/强酸材质、
// 没有场景铺设它们），纯属提前占位。等 `lava`/`acid` 真正落地 materials.ron
// 那天，把这两项加回来即可，不是缺陷、是范围裁剪。
//
// swim_buoyancy_up = 1.4（评审 Important #2，2026-09-05，**故意偏离 Noita 原值
// 0.9**）：Noita 玩家在水里还有一份独立的喷射推力在做上升，那三个系数在 Noita
// 那边只调被动浮力；我们没有该推力，若照抄 0.9（< idle 的 1.2）会让"按住上"反而
// 比什么都不按沉得更快。必须 > swim_buoyancy_idle 才能让 up > idle > down 的方向
// 语义成立——1.4 是起步值，日后目检再调（A 类手感旋钮）。**不要照着 Noita 数值
// 表把它"修正"回 0.9**：详见 CreatureTpl::swim_buoyancy_up 字段文档。
(
  templates: [
    (
      name: "player",
      half_w: 2, half_h: 5,
      hp_max: 100.0, mana_max: 100.0, mana_regen: 20.0,
      run_speed: 0.67, jump_speed: 2.9,
      accel_ground: 0.05, accel_air: 0.005,
      climb_over_y: 3,
      swim_buoyancy_idle: 1.2, swim_buoyancy_up: 1.4, swim_buoyancy_down: 0.7,
      swim_drag: 0.95,
      damage_from: [ ("fire", 3.0) ], // lava/acid 缺口说明见文件头注
      min_cell_count: 4,
      max_displace_per_tick: 24,
      // muzzle_offset 必须严格大于 max(half_w, half_h)（评审 I3，
      // load_creatures 加载期强制校验，见 crates/sand-harness/src/scenario.rs
      // ::load_creatures）：half_w=2 < half_h=5，旧值 3 只清了 half_w、没清
      // half_h——竖直方向（aim=90°/270°）出射时弹体会生在自身 AABB 内部，
      // 全靠 grace 帧兜底防自伤。6 > half_h=5，任意方向都出生在自身 AABB 外。
      muzzle_offset: 6,
    ),
  ],
)
